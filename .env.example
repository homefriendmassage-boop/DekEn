# Copy to .env.local and fill in. Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# LIFF app ID (LINE Developers Console > LINE Login channel > LIFF)
VITE_LIFF_ID=1234567890-AbCdEfGh

# true  = skip LINE, sign in as an anonymous test user (browser testing)
# false = real LIFF login (must be opened via https://liff.line.me/<LIFF_ID>)
VITE_USE_MOCK_LIFF=true
